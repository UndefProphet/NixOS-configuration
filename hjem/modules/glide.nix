{
  lib,
  pkgs,
  inputs,
  ...
}:
{
  tack.inputs.glide-browser = "gh:glide-browser/glide.nix";

  flake.modules.hjem-modules.glide =
    {
      config,
      pkgs,
      inputs,
      ...
    }:
    let
      cfg = config.programs.glide;

      # Profiles root patched into glide's nsXREDirProvider; native messaging
      # hosts live outside of it under `.glide-browser`.
      profilesPath = ".config/glide/glide";
      nativeHostsPath = ".glide-browser/native-messaging-hosts";
      extensionsPath = "extensions/{ec8030f7-c20a-464f-9b0e-13a3a9e97384}";

      jsonFormat = pkgs.formats.json { };

      userPrefValue =
        pref:
        builtins.toJSON (
          if builtins.isBool pref || builtins.isInt pref || builtins.isString pref then
            pref
          else
            builtins.toJSON pref
        );

      mkUserJs =
        profile:
        let
          prePrefs = lib.optionalAttrs (profile.extensions.settings != { }) {
            "extensions.webextensions.ExtensionStorageIDB.enabled" = false;
          };
          prefs = prePrefs // profile.settings;
          prefLines =
            prefs |> lib.mapAttrsToList (name: value: ''user_pref("${name}", ${userPrefValue value});'');
        in
        lib.concatStringsSep "\n" ([ "// Generated by Hjem." ] ++ prefLines);

      # Map friendly engine field names to the internal (underscore prefixed)
      # names `search.json.mozlz4` expects.
      internalFieldNames =
        (lib.genAttrs [
          "name"
          "isAppProvided"
          "loadPath"
          "updateInterval"
          "updateURL"
          "iconMapObj"
          "metaData"
          "orderHint"
          "definedAliases"
          "urls"
        ] (name: "_${name}"))
        // {
          searchForm = "__searchForm";
        };

      iconUrl = icon: if lib.isPath icon || lib.hasPrefix "/" icon then "file://${icon}" else icon;

      mkEngine =
        profileName: id: engine:
        let
          iconMap = (lib.optionalAttrs (engine ? icon) { "16" = engine.icon; }) // (engine.iconMapObj or { });

          engineFields = {
            name = id;
            isAppProvided = false;
            metaData = { };
          }
          // (lib.removeAttrs engine [ "icon" ]);

          engineWithIcon =
            engineFields
            // (lib.optionalAttrs (iconMap != { }) {
              iconMapObj = iconMap |> lib.mapAttrs (_: iconUrl);
            });
        in
        (
          engineWithIcon
          |> lib.mapAttrs' (name: value: lib.nameValuePair (internalFieldNames.${name} or name) value)
        )
        // {
          _loadPath = "[hjem]/programs.glide.profiles.${profileName}.search.engines.${id}";
        };

      mkSearchFile =
        profileName: profile:
        let
          engineConfig = profile.search.engines |> lib.mapAttrs (mkEngine profileName);

          ordered =
            profile.search.order
            |> lib.imap (
              index: id:
              let
                engine =
                  engineConfig.${id} or {
                    _isAppProvided = true;
                    _metaData = { };
                  };
              in
              engine
              // {
                _metaData = engine._metaData // {
                  order = index;
                };
              }
            );

          rest =
            engineConfig |> lib.filterAttrs (id: _: !(lib.elem id profile.search.order)) |> lib.attrValues;

          settings = {
            version = 12;
            engines = ordered ++ rest;
            metaData.useSavedOrder = profile.search.order != [ ];
          };
        in
        pkgs.runCommand "search.json.mozlz4" { json = builtins.toJSON settings; } ''
          ${pkgs.mozlz4a}/bin/mozlz4a <(echo "$json") "$out"
        '';

      mkProfileFiles =
        name: profile:
        let
          rootDir = "${profilesPath}/${profile.path}";
        in
        (lib.optionalAttrs (profile.settings != { } || profile.extensions.settings != { }) {
          "${rootDir}/user.js".text = mkUserJs profile;
        })

        // (lib.optionalAttrs (profile.extensions.packages != [ ]) {
          "${rootDir}/extensions".source =
            let
              extensions = pkgs.buildEnv {
                name = "glide-extensions-${name}";
                paths = profile.extensions.packages;
              };
            in
            "${extensions}/share/mozilla/${extensionsPath}";
        })

        // (lib.optionalAttrs (profile.extensions.settings != { }) (
          profile.extensions.settings
          |> lib.mapAttrs' (
            id: content:
            lib.nameValuePair "${rootDir}/browser-extension-data/${id}/storage.js" {
              text = builtins.toJSON content;
              clobber = profile.extensions.force;
            }
          )
        ))

        // (lib.optionalAttrs (profile.search.engines != { }) {
          "${rootDir}/search.json.mozlz4" = {
            source = mkSearchFile name profile;
            clobber = profile.search.force;
          };
        });
    in
    {
      options.programs.glide = with lib.types; {
        enable = lib.mkEnableOption {
          description = "Enable glide browser";
        };

        package = lib.mkOption {
          description = "The glide browser package.";
          type = nullOr package;
          default = inputs.glide-browser.packages.${pkgs.stdenv.hostPlatform.system}.glide-browser-bin;
        };

        nativeMessagingHosts = lib.mkOption {
          description = "Packages containing native messaging hosts for glide extensions.";
          type = listOf package;
          default = [ ];
        };

        configuration = lib.mkOption {
          description = "Typescript code used to configure glide.";
          type = lib.types.lines;
          default = "";
        };

        profiles = lib.mkOption {
          description = "Attribute set of glide profiles.";
          type = attrsOf (
            submodule (
              { config, name, ... }: {
                options = {
                  name = lib.mkOption {
                    description = "Profile name.";
                    type = str;
                    default = name;
                  };

                  id = lib.mkOption {
                    description = "Unique profile id.";
                    type = ints.unsigned;
                    default = 0;
                  };

                  path = lib.mkOption {
                    description = "Profile directory name.";
                    type = str;
                    default = name;
                  };

                  isDefault = lib.mkOption {
                    description = "Whether this is the default profile.";
                    type = bool;
                    default = config.id == 0;
                  };

                  settings = lib.mkOption {
                    description = "Preferences written to the profile's user.js.";
                    inherit (jsonFormat) type;
                    default = { };
                  };

                  extensions.force = lib.mkOption {
                    description = ''
                      Whether to override all previous extension settings;
                      required when extensions.settings is used.
                    '';
                    type = bool;
                    default = false;
                    example = true;
                  };

                  extensions.packages = lib.mkOption {
                    description = "Addon packages to install into the profile.";
                    type = listOf package;
                    default = [ ];
                  };

                  extensions.settings = lib.mkOption {
                    description = ''
                      Addon storage keyed by addonId, written to
                      browser-extension-data/`<addonId>`/storage.js.
                    '';
                    type = attrsOf (attrsOf jsonFormat.type);
                    default = { };
                  };

                  search.force = lib.mkOption {
                    description = "Whether to force replace the search configuration.";
                    type = bool;
                    default = false;
                  };

                  search.order = lib.mkOption {
                    description = "Order of search engines listed in the profile.";
                    type = uniq (listOf str);
                    default = [ ];
                  };

                  search.engines = lib.mkOption {
                    description = ''
                      Custom search engines; `icon` is a convenience for an
                      iconMapObj entry with a single absolute path under `16`.
                    '';
                    type = attrsOf (attrsOf jsonFormat.type);
                    default = { };
                  };
                };
              }
            )
          );
          default = { };
        };
      };

      config = lib.mkIf cfg.enable (
        lib.mkMerge [
          {
            packages = lib.optional (cfg.package != null) cfg.package;
          }

          (lib.mkIf (cfg.nativeMessagingHosts != [ ]) {
            files."${nativeHostsPath}".source =
              let
                hosts = pkgs.symlinkJoin {
                  name = "glide-native-messaging-hosts";
                  paths = cfg.nativeMessagingHosts;
                };
              in
              "${hosts}/lib/mozilla/native-messaging-hosts";
          })

          (lib.mkIf (cfg.profiles != { }) {
            files = {
              "${profilesPath}/profiles.ini".text =
                let
                  profileEntries =
                    cfg.profiles
                    |> lib.mapAttrs' (
                      _: profile:
                      lib.nameValuePair "Profile${toString profile.id}" {
                        Name = profile.name;
                        Path = profile.path;
                        IsRelative = 1;
                        Default = if profile.isDefault then 1 else 0;
                      }
                    );
                in
                (profileEntries // { General.StartWithLastProfile = 1; }) |> lib.generators.toINI { };
            }
            // (cfg.profiles |> lib.mapAttrsToList mkProfileFiles |> lib.mergeAttrsList);
          })

          (lib.mkIf (cfg.configuration != "") {
            xdg.config.files."glide/glide.ts".text = cfg.configuration;
          })

          {
            assertions =
              let
                duplicateIds =
                  cfg.profiles
                  |> lib.attrValues
                  |> lib.groupBy (profile: toString profile.id)
                  |> lib.filterAttrs (_: profiles: lib.length profiles > 1);
              in
              [
                {
                  assertion = cfg.profiles == { } || duplicateIds == { };
                  message = "Must not have duplicate glide profile ids: ${lib.concatStringsSep ", " (lib.attrNames duplicateIds)}";
                }
              ]
              ++ (
                cfg.profiles
                |> lib.mapAttrsToList (
                  name: profile: {
                    assertion = profile.extensions.settings == { } || profile.extensions.force;
                    message = ''
                      Setting programs.glide.profiles.${name}.extensions.settings requires
                      programs.glide.profiles.${name}.extensions.force.
                    '';
                  }
                )
              );
          }
        ]
      );
    };
}
